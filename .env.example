# Supabase PostgreSQL – Session-Pooler (Port 5432) für Prisma-Transaktionen
# Passwort URL-kodieren (z. B. ! → %21)
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Optional: gleiche Session-URL (kein Prisma directUrl im Schema erforderlich)
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# NextAuth – NEXTAUTH_URL muss zur echten Origin passen (lokal oder Vercel)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-secret-at-least-32-chars"

# Dateispeicher: local | supabase
# Auf Vercel: supabase (lokales Dateisystem ist nicht persistent)
STORAGE_TYPE="local"
UPLOAD_DIR="./uploads"

# Supabase Storage (wenn STORAGE_TYPE=supabase)
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="flx-rent-uploads"

# S3 ist in dieser Demo deaktiviert
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="eu-central-1"
S3_PUBLIC_URL=""

# E-Mail (vorbereitet, nicht angebunden)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@flx-software.de"
